{
    "name": "monei/sylius-monei-plugin",
    "type": "sylius-plugin",
    "description": "MONEI payments for Sylius: card, Bizum, PayPal, Apple Pay, Google Pay, MB WAY and Multibanco.",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "monei",
        "payment",
        "bizum",
        "paypal",
        "apple-pay",
        "google-pay",
        "mbway",
        "multibanco"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "MONEI",
            "homepage": "https://monei.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "monei/monei-php-sdk": "^2.13",
        "sylius/sylius": "^2.2.9"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^11.5",
        "sylius/refund-plugin": "^2.2",
        "sylius/test-application": "^2.2.0@alpha || ^2.3.0@alpha",
        "symfony/browser-kit": "^6.4 || ^7.4",
        "symfony/debug-bundle": "^6.4 || ^7.4",
        "symfony/dotenv": "^6.4 || ^7.4",
        "symfony/intl": "^6.4 || ^7.4",
        "symfony/runtime": "^6.4 || ^7.4",
        "symfony/web-profiler-bundle": "^6.4 || ^7.4"
    },
    "suggest": {
        "sylius/refund-plugin": "Partial refunds from the Sylius admin"
    },
    "conflict": {
        "sylius/refund-plugin": "<2.2"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Monei\\SyliusPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Monei\\SyliusPlugin\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false,
            "symfony/flex": false,
            "symfony/runtime": true
        }
    },
    "extra": {
        "public-dir": "vendor/sylius/test-application/public",
        "symfony": {
            "require": "^7.4"
        }
    }
}
