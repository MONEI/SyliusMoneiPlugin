{% set config = hookable_metadata.context.form.gatewayConfig.config %}

<style>
    .monei-credentials:has(option:checked:not([value="manual"])) ~ .monei-manual-credential {
        display: none;
    }
</style>
<div class="col-12 col-md-6 monei-credentials">
    {{ form_row(config.credentials) }}
</div>
<div class="col-12 col-md-6 monei-manual-credential">
    {{ form_row(config.api_key) }}
</div>
<div class="col-12 col-md-6">
    {{ form_row(config.payment_method) }}
</div>
<div class="col-12 col-md-6">
    {{ form_row(config.mode) }}
</div>
<div class="col-12 col-md-6">
    {{ form_row(config.order_id_prefix) }}
</div>
<div class="col-12 col-md-6">
    {{ form_row(config.use_authorize, { label_attr: { class: 'checkbox-switch' } }) }}
</div>
<div class="col-12 col-md-6">
    {{ form_row(config.card_layout) }}
</div>
<div class="col-12 col-md-6 monei-manual-credential">
    {{ form_row(config.account_id) }}
</div>
