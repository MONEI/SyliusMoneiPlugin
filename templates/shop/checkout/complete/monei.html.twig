{% set monei = monei_inline_checkout(hookable_metadata.context.order) %}

{% if monei is not null %}
    {# Inside the Complete form. The token and the cardholder name stay in the browser: the cardholder input has no name, so it never posts. #}
    <div
        id="monei-inline"
        class="mb-4"
        data-component="{{ monei.component }}"
        data-account-id="{{ monei.account_id }}"
        data-session-id="{{ monei.session_id }}"
        data-amount="{{ monei.amount }}"
        data-currency="{{ monei.currency }}"
        data-language="{{ monei.language }}"
        data-transaction-type="{{ monei.transaction_type }}"
        data-method-code="{{ monei.method_code }}"
        data-cardholder-name-required="{{ 'monei.ui.onsite.cardholder_name_required'|trans }}"
        data-processing="{{ 'monei.ui.inline.processing'|trans }}"
        {% if monei.component == 'card' %}data-card-layout="{{ monei.card_layout }}"{% endif %}
    >
        {% if monei.component == 'card' %}
            {% include '@MoneiSyliusPlugin/shop/shared/monei_card_fields.html.twig' with { card_layout: monei.card_layout, cardholder_input_name: null } only %}
        {% else %}
            {# Not id="monei-paypal": element ids are window properties, and the PayPal SDK reads window["monei-paypal"]. #}
            <div id="monei-component"></div>
        {% endif %}
        <div class="invalid-feedback d-block" id="monei-inline-error" aria-live="polite"></div>
    </div>
    <script src="https://js.monei.com/v3/monei.js"></script>
    {% include '@MoneiSyliusPlugin/shop/shared/monei_card_script.html.twig' %}
    <script>
        (function () {
            var tokenLifetime = 15 * 60 * 1000;
            var root = document.getElementById('monei-inline');
            var data = root.dataset;
            var form = root.closest('form');
            var errorBox = document.getElementById('monei-inline-error');
            var placeOrder;
            var ready = false;
            var failed = false;
            var submitting = false;

            function showError(message) {
                errorBox.textContent = message || '';
            }

            function setBusy(busy) {
                placeOrder.disabled = busy;
                var spinner = placeOrder.querySelector('.monei-spinner');
                if (busy && !spinner) {
                    spinner = document.createElement('span');
                    spinner.className = 'spinner-border spinner-border-sm me-2 monei-spinner';
                    spinner.setAttribute('role', 'status');
                    var label = document.createElement('span');
                    label.className = 'visually-hidden';
                    label.textContent = data.processing;
                    spinner.appendChild(label);
                    placeOrder.prepend(spinner);
                } else if (!busy && spinner) {
                    spinner.remove();
                }
            }

            // The pay page after Place order confirms the payment with this entry and removes it.
            function submitWithToken(token, cardholderName) {
                if (submitting) {
                    return;
                }
                submitting = true;
                try {
                    window.sessionStorage.setItem('monei.inline.' + data.sessionId, JSON.stringify({
                        token: token,
                        cardholderName: cardholderName,
                        methodCode: data.methodCode,
                        expiresAt: Date.now() + tokenLifetime
                    }));
                } catch (e) {
                    // Without the entry the pay page shows its own fields.
                }
                // form.submit() fires no submit event, so the card handler does not run again.
                form.submit();
            }

            // From here Place order submits without a token, and the pay page shows its own fields.
            function fallBack() {
                failed = true;
                setBusy(false);
                placeOrder.hidden = false;
            }

            function initCard() {
                var cardholder = document.getElementById('monei-cardholder-name');
                var card = window.moneiSyliusCard({
                    root: root,
                    cardholder: cardholder,
                    layout: data.cardLayout,
                    props: { accountId: data.accountId, sessionId: data.sessionId, language: data.language },
                    onError: showError,
                    onLoad: function () { ready = true; },
                    onFailure: fallBack
                });
                form.addEventListener('submit', function (event) {
                    if (!ready || failed) {
                        return;
                    }
                    event.preventDefault();
                    var cardholderName = cardholder.value.trim();
                    if ('' === cardholderName) {
                        showError(data.cardholderNameRequired);
                        return;
                    }
                    showError('');
                    setBusy(true);
                    card.submit().then(function (result) {
                        if (!result.token) {
                            setBusy(false);
                            showError(result.error);
                            return;
                        }
                        submitWithToken(result.token, cardholderName);
                    }, function () {
                        fallBack();
                        form.submit();
                    });
                });
            }

            function initButton() {
                var props = {
                    accountId: data.accountId,
                    sessionId: data.sessionId,
                    amount: Number(data.amount),
                    currency: data.currency,
                    language: data.language,
                    style: { height: Math.round(placeOrder.getBoundingClientRect().height) || 48 },
                    // false: no wallet in this browser, or the method is not available. Place order stays.
                    onLoad: function (supported) {
                        if (supported && !failed) {
                            placeOrder.hidden = true;
                        }
                    },
                    onSubmit: function (result) {
                        result.token ? submitWithToken(result.token, null) : showError(result.error);
                    },
                    onError: fallBack
                };
                if ('paypal' === data.component) {
                    props.transactionType = data.transactionType;
                }
                ({ bizum: monei.Bizum, paypal: monei.PayPal, payment_request: monei.PaymentRequest })[data.component](props).render('#monei-component');
            }

            function init() {
                placeOrder = form.querySelector('button[type=submit]');
                // Without monei.js, Place order submits without a token.
                if (!placeOrder || !window.monei) {
                    return;
                }
                // Back from the next page: the button must work again.
                window.addEventListener('pageshow', function () {
                    submitting = false;
                    setBusy(false);
                });
                'card' === data.component ? initCard() : initButton();
            }

            // Place order renders after this hook.
            'loading' === document.readyState ? document.addEventListener('DOMContentLoaded', init) : init();
        })();
    </script>
{% endif %}
