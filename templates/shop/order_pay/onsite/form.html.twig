{% set monei = hookable_metadata.context.monei %}

<h1 class="h2 mb-4">{{ 'monei.ui.onsite.title'|trans }}</h1>

<form
    id="monei-onsite"
    data-component="{{ monei.component }}"
    data-payment-id="{{ monei.payment_id }}"
    data-transaction-type="{{ monei.transaction_type }}"
    data-after-pay-url="{{ monei.after_pay_url }}"
    data-cardholder-name-required="{{ 'monei.ui.onsite.cardholder_name_required'|trans }}"
    {% if monei.component == 'card' %}data-card-layout="{{ monei.card_layout }}"{% endif %}
    novalidate
>
    {% if monei.component == 'card' %}
        {% include '@MoneiSyliusPlugin/shop/shared/monei_card_fields.html.twig' with { card_layout: monei.card_layout, cardholder_input_name: 'cardholder_name' } only %}
        <button class="btn btn-primary" type="submit">{{ 'monei.ui.onsite.pay'|trans }}</button>
    {% else %}
        {# Not id="monei-paypal": element ids are window properties, and the PayPal SDK reads window["monei-paypal"]. #}
        <div id="monei-component"></div>
    {% endif %}
    <div class="invalid-feedback d-block mt-3" id="monei-onsite-error" aria-live="polite"></div>
</form>
