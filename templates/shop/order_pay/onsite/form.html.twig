{% set monei = hookable_metadata.context.monei %}

<h1 class="h2 mb-4">{{ 'monei.ui.onsite.title'|trans }}</h1>

<form
    id="monei-onsite"
    data-component="{{ monei.component }}"
    data-payment-id="{{ monei.payment_id }}"
    data-transaction-type="{{ monei.transaction_type }}"
    data-after-pay-url="{{ monei.after_pay_url }}"
    data-cardholder-name-required="{{ 'monei.ui.onsite.cardholder_name_required'|trans }}"
    {% if monei.component == 'card' %}data-card-layout="{{ monei.card_layout }}"{% endif %}
    novalidate
>
    {% if monei.component == 'card' %}
        {# monei.js mounts each card field in an iframe; the container is the visible box, sized and styled by the script. #}
        <style>
            .form-control.monei-card-part { padding: 0; }
            .monei-card-part > *, .monei-card-part iframe { height: 100% !important; }
        </style>
        <div class="mb-3">
            <label class="form-label" for="monei-cardholder-name">{{ 'monei.ui.onsite.cardholder_name'|trans }}</label>
            <input class="form-control" id="monei-cardholder-name" name="cardholder_name" autocomplete="cc-name" required>
        </div>
        {% if monei.card_layout == 'single' %}
            <div class="mb-3">
                <label class="form-label">{{ 'monei.ui.onsite.card_details'|trans }}</label>
                <div class="form-control monei-card-part" id="monei-card-input"></div>
            </div>
        {% else %}
            <div class="mb-3">
                <label class="form-label">{{ 'monei.ui.onsite.card_number'|trans }}</label>
                <div class="form-control monei-card-part" id="monei-card-number"></div>
            </div>
            <div class="row g-3 mb-3">
                <div class="col">
                    <label class="form-label">{{ 'monei.ui.onsite.card_expiry'|trans }}</label>
                    <div class="form-control monei-card-part" id="monei-card-expiry"></div>
                </div>
                <div class="col">
                    <label class="form-label">{{ 'monei.ui.onsite.card_cvc'|trans }}</label>
                    <div class="form-control monei-card-part" id="monei-card-cvc"></div>
                </div>
            </div>
        {% endif %}
        <button class="btn btn-primary" type="submit">{{ 'monei.ui.onsite.pay'|trans }}</button>
    {% else %}
        {# Not id="monei-paypal": element ids are window properties, and the PayPal SDK reads window["monei-paypal"]. #}
        <div id="monei-component"></div>
    {% endif %}
    <div class="text-danger mt-3" id="monei-onsite-error" role="alert"></div>
</form>
