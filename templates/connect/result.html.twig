{#
 # The page of the Connect with MONEI callback, a whole HTML document.
 #
 # Same page as in the WooCommerce, PrestaShop and Magento plugins: colors from the MONEI Dashboard theme, the
 # plugin's own logo file and the system font, so nothing loads from another host.
 #}
{% set state = result.switched is not empty ? 'connected' : (result.problems|filter(p => p.code in ['missingCode', 'unknownState', 'expiredState']) is not empty ? 'refused' : 'failed') %}
{% set title = ('monei.connect.callback_' ~ state)|trans %}
<!doctype html>
<html lang="{{ app.request.locale|replace({'_': '-'}) }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ title }} · MONEI</title>
    <style>
        :root {
            --primary: #65427e;
            --primary-hover: #74558b;
            --primary-foreground: #fafafa;
            --success: #00a96e;
            --success-tint: rgba(0, 169, 110, .1);
            --destructive: #df2225;
            --destructive-tint: rgba(223, 34, 37, .1);
            --foreground: #0a0a0a;
            --muted-foreground: #5e5e5e;
            --background: #f3f3f3;
            --muted: #f5f5f5;
            --line: #e5e5e5;
        }
        *, *::before, *::after { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px 16px;
            background: var(--background);
            color: var(--foreground);
            font: 15px/1.5 -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
        }
        .card {
            width: 100%;
            max-width: 440px;
            padding: 40px 32px 32px;
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 20px;
            box-shadow: 0 4px 12px rgba(10, 10, 10, .06);
            text-align: center;
        }
        .logo { display: block; height: 24px; width: auto; margin: 0 auto 32px; }
        .status {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 56px;
            height: 56px;
            margin: 0 auto 16px;
            border-radius: 999px;
            background: var(--success-tint);
            color: var(--success);
        }
        .status--error { background: var(--destructive-tint); color: var(--destructive); }
        h1 { margin: 0 0 20px; color: var(--foreground); font-size: 22px; line-height: 1.3; font-weight: 600; }
        .lines { margin: 0 0 24px; padding: 0; list-style: none; text-align: left; }
        .lines li {
            display: flex;
            gap: 10px;
            padding: 12px 14px;
            border-radius: 14px;
            background: var(--muted);
        }
        .lines li + li { margin-top: 8px; }
        .lines svg { flex: none; margin-top: 3px; }
        .line--ok svg { color: var(--success); }
        .line--problem svg { color: var(--muted-foreground); }
        .button {
            display: inline-block;
            padding: 12px 24px;
            border-radius: 999px;
            background: var(--primary);
            color: var(--primary-foreground);
            font-weight: 600;
            text-decoration: none;
        }
        .button:hover, .button:focus-visible { background: var(--primary-hover); }
        .button:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }
        .hint { margin: 16px 0 0; color: var(--muted-foreground); font-size: 13px; }
    </style>
</head>
<body>
    <main class="card" role="status">
        <img class="logo" src="{{ asset('bundles/moneisyliusplugin/images/monei.svg') }}" alt="MONEI" width="110" height="24">
        <div class="status{{ state != 'connected' ? ' status--error' }}" aria-hidden="true">
            {% if state == 'connected' %}
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            {% else %}
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v5M12 16.5v.01"/><circle cx="12" cy="12" r="9"/></svg>
            {% endif %}
        </div>
        <h1>{{ title }}</h1>
        {% if result.switched is not empty or result.problems is not empty %}
            <ul class="lines">
                {% for mode in result.switched %}
                    <li class="line--ok">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                        <span>{{ 'monei.connect.connected'|trans({'%mode%': ('monei.connect.mode.' ~ mode)|trans}) }}</span>
                    </li>
                {% endfor %}
                {% for problem in result.problems %}
                    {% set key = 'monei.connect.problem.' ~ problem.code %}
                    {% set message = key|trans %}
                    <li class="line--problem">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8v.01"/></svg>
                        <span>{% if problem.mode %}<strong>{{ ('monei.connect.mode.' ~ problem.mode)|trans }}:</strong> {% endif %}{{ message == key ? 'monei.connect.problem.generic'|trans : message }}</span>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
        {# An invalid or used link names no connect that this shop started, so it gets no link into the admin. #}
        {% if state != 'refused' %}
            <a class="button" href="{{ url('monei_sylius_admin_connect') }}">{{ 'monei.connect.go_to_settings'|trans }}</a>
            <p class="hint">{{ 'monei.connect.close_hint'|trans }}</p>
        {% endif %}
    </main>
</body>
</html>
